{
  "name": "@local/dsh-kiln",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "DSH × kiln：只读 kiln 仓库的三页视图；一个视图一条命令（动作流 mount、关系图与详情按需），需 kiln v0.2.0+，搜索 v0.2.1+，动作流 v0.3.0+",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/run.mjs && node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-renderer"]
    }
  }
}

