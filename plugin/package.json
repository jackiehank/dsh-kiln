{
  "name": "@local/dsh-kiln",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH × kiln：在会话顶部加一个只读的 kiln Flow 视图（需要 kiln v0.2.0+）",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/run.mjs && node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-renderer"]
    }
  }
}

