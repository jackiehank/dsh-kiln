{
  "name": "@jackiehank/dsh-kiln",
  "version": "0.14.0",
  "type": "module",
  "description": "DSH 插件：把 kiln 的 issue 与动作历史投影成会话内的三页视图（时间线 / issue / 关系图），只读；取数需 kiln v0.2.0+，搜索 v0.2.1+，动作流与词表 v0.3.0+",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackiehank/dsh-kiln.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/jackiehank/dsh-kiln#readme",
  "bugs": {
    "url": "https://github.com/jackiehank/dsh-kiln/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "kiln", "git", "issue-tracker"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/run.mjs && node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-renderer"]
    }
  }
}
